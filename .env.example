# CoryPulse configuration

# ---------------------------------------------------------------- web server
PORT=8787
# Public HTTPS URL of this deployment. Used for M-Pesa callbacks and secure cookies.
PUBLIC_URL=https://wifi.example.com
# Docker Compose only: domain Caddy should obtain a certificate for.
DOMAIN=wifi.example.com

# 64-hex-character key used to encrypt router/API/RADIUS secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key with your backups: without it, stored router secrets cannot be read.
CREDENTIALS_KEY=

# ---------------------------------------------------------------- PostgreSQL
# Real PostgreSQL 14+ (TimescaleDB recommended for long retention).
# Local development without PostgreSQL: npm run dev:db (PGlite on port 5432).
DATABASE_URL=postgres://corypulse:change-me@127.0.0.1:5432/corypulse
PG_POOL_MAX=20
APP_TIMEZONE=Africa/Nairobi

# Docker Compose only: credentials for the bundled TimescaleDB container.
POSTGRES_USER=corypulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=corypulse

# ---------------------------------------------------------------- process role
# all    = HTTP API + poller + ingest (default, single server)
# api    = HTTP API + poller only
# ingest = RADIUS + syslog listeners only (no HTTP)
ROLE=all
INSTANCE_ID=

# ---------------------------------------------------------------- security
# Which peers may set X-Forwarded-For. Keep this to your proxy network; on a
# bare-metal install behind no proxy, set it to "false" so clients cannot spoof
# their address and bypass rate limits.
TRUST_PROXY=loopback, uniquelocal
SESSION_DAYS=7
MAX_SSE_CLIENTS=200
API_BODY_LIMIT=100kb
API_RATE_PER_MINUTE=3000

# ---------------------------------------------------------------- polling
POLL_CONCURRENCY=48
POLL_INTERVAL_S=60
SESSION_INVENTORY_S=300

# ---------------------------------------------------------------- telemetry ingest
INGEST_ENABLED=1
# Shared RADIUS secret. Routers can override it in Sites & routers.
RADIUS_SECRET=change-me
RADIUS_PORT=1813
SYSLOG_PORT=514
SYSLOG_TCP_PORT=1514

# ---------------------------------------------------------------- retention (days)
METRIC_RETENTION_DAYS=90
LOG_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=365

# ---------------------------------------------------------------- M-Pesa Daraja (optional)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_SECRET=
